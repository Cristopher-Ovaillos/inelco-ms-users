                      },
                      "direccion": {
                        "type": "string",
                        "example": "Av. Siempreviva 742"
                      },
                      "contacto_adicional": {
                        "type": "string",
                        "example": "Mesa de compras"
                      },
                      "info_comercial": {
                        "type": "string",
                        "example": "Contrato de mantenimiento anual"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/empleados/": {
      "post": {
        "tags": [
          "Empleados"
        ],
        "summary": "Registra un empleado con su estado de empleo y su token de invitación",
        "description": "",
        "responses": {
          "201": {
            "description": "Empleado creado"
          },
          "400": {
            "description": "Datos inválidos"
