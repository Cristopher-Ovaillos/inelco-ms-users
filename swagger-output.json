                      },
                      "nombre_completo": {
                        "type": "string",
                        "example": "Laura Gómez"
                      },
                      "telefono": {
                        "type": "string",
                        "example": "+54 9 11 5555-1234"
                      }
                    }
                  },
                  "cliente": {
                    "type": "object",
                    "properties": {
                      "razon_social": {
                        "type": "string",
