          "201": {
            "description": "Cliente creado"
          },
          "400": {
            "description": "Datos inválidos"
          },
          "409": {
            "description": "El email ya está registrado"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
