                          "activo",
                          "licencia",
                          "baja"
                        ],
                        "example": "activo"
                      },
                      "fecha_ingreso": {
                        "type": "string",
                        "example": "2026-03-01"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/empleados/{empleado_id}/permisos": {
